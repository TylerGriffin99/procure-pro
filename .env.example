# Database Configuration (REQUIRED)
POSTGRES_DB=procure-ai-local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

SECRET_KEY=dev-secret-key-change-in-production

# LLM Provider Configuration
# Provider: "anthropic", "openai", "openrouter", "deepseek" or "jev"
LLM_PROVIDER=deepseek
# Model to use (provider-specific, e.g. "claude-sonnet-4-20250514", "gpt-4o", "deepseek-chat", "qwen/qwen3-8b")
LLM_MODEL=deepseek-chat

# API Keys — only the key for your chosen provider is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=